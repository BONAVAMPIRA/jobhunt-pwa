{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/jobs",           "destination": "/api/jobs.js" },
    { "source": "/api/briefing",       "destination": "/api/jobs.js" },
    { "source": "/api/docs-status",    "destination": "/api/jobs.js" },
    { "source": "/api/job-action",     "destination": "/api/jobs.js" },
    { "source": "/api/rescore",        "destination": "/api/jobs.js" },
    { "source": "/api/rescore-result", "destination": "/api/jobs.js" },
    { "source": "/api/generate-docs",  "destination": "/api/jobs.js" },
    { "source": "/api/crons",          "destination": "/api/jobs.js" },
    { "source": "/api/crons/:path*",   "destination": "/api/jobs.js" },
    { "source": "/api/services",       "destination": "/api/jobs.js" },
    { "source": "/api/config",         "destination": "/api/jobs.js" },
    { "source": "/api/postuler-jobs",  "destination": "/api/jobs.js" },
    { "source": "/api/suivi",          "destination": "/api/jobs.js" },
    { "source": "/api/doc",            "destination": "/api/jobs.js" },
    { "source": "/api/cv-pdf",         "destination": "/api/jobs.js" },
    { "source": "/api/cv-yaml",        "destination": "/api/jobs.js" },
    { "source": "/api/cv-render",      "destination": "/api/jobs.js" },
    { "source": "/api/perso",          "destination": "/api/jobs.js" },
    { "source": "/api/profil",         "destination": "/api/jobs.js" },
    { "source": "/api/mark-postule",   "destination": "/api/jobs.js" },
    { "source": "/((?!api/).*)",       "destination": "/index.html" }
  ]
}
